APP_NAME="Roumdoul Order"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Where the customer ordering site (Next.js) runs. Used for QR code links.
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8+ (create the database first with utf8mb4 so Khmer text works)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roumdoul_order
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480

FILESYSTEM_DISK=public

# Local development on Windows: database cache + queue (no Redis needed).
# Production: CACHE_STORE=redis and QUEUE_CONNECTION=redis.
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@roumdoul.local"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram alerts (Step 1)
TELEGRAM_BOT_TOKEN=

# Live updates (Laravel Reverb). start.bat runs "php artisan reverb:start". Without it, screens just poll.
# Local values only: use your own random key and secret in production, and put the same key in
# NEXT_PUBLIC_REVERB_KEY in frontend/.env.local.
REVERB_APP_ID=100001
REVERB_APP_KEY=roumdoul-local-key
REVERB_APP_SECRET=roumdoul-local-secret-change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
