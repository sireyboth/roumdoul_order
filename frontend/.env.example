# Laravel backend (server-side only; the browser never calls it directly in Step 0)
API_URL=http://127.0.0.1:8000

# Live updates (Reverb). Must match REVERB_APP_KEY in backend/.env. Leave the key empty to only poll.
# The host defaults to the address the page was opened on (works for phones on the shop Wi-Fi).
NEXT_PUBLIC_REVERB_KEY=roumdoul-local-key
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
